# Copy to .env.local (local) and add the same four names in Vercel > Project > Settings > Environment Variables.
# Never commit real values.
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
ADMIN_PASSWORD=
# Any long random string. Changing it logs you out everywhere.
ADMIN_SESSION_SECRET=
# Optional. The public address of the site once it has its own domain (used by the link preview).
NEXT_PUBLIC_SITE_URL=
# Optional. Email alerts for new messages. The Resend account must use the ALERT_EMAIL address
# (without your own domain, Resend only delivers to the account owner).
RESEND_API_KEY=
ALERT_EMAIL=
